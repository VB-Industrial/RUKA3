<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="ruka3_ros2_control"
    params="name initial_positions_file use_mock_hardware:=true can_interface:=can0 feedback_timeout:=0.25 heartbeat_timeout:=2.5 activation_timeout:=5.0">
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <xacro:property
      name="use_mock_hardware_bool"
      value="${str(use_mock_hardware).lower() in ['true', '1', 'yes']}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware_bool}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware_bool}">
          <plugin>ruka3_control/Ruka3System</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="feedback_timeout">${feedback_timeout}</param>
          <param name="heartbeat_timeout">${heartbeat_timeout}</param>
          <param name="activation_timeout">${activation_timeout}</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="ruka3_arm_joint" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <state_interface name="position">
            <param name="initial_value">${initial_positions[joint_name]}</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:ruka3_arm_joint joint_name="joint_1"/>
      <xacro:ruka3_arm_joint joint_name="joint_2"/>
      <xacro:ruka3_arm_joint joint_name="joint_3"/>
      <xacro:ruka3_arm_joint joint_name="joint_4"/>
      <xacro:ruka3_arm_joint joint_name="joint_5"/>
      <xacro:ruka3_arm_joint joint_name="joint_6"/>
    </ros2_control>
  </xacro:macro>
</robot>
