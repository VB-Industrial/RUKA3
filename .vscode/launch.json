{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "g431DebugJoint",
      "type": "pickString",
      "description": "Joint to attach",
      "options": ["5", "6"],
      "default": "5"
    }
  ],
  "configurations": [
    {
      "name": "Attach joint (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/g431-joint${input:g431DebugJoint}/Boards/g431/VBDrive.elf",
      "device": "STM32G431VBTx",
      "interface": "swd",
      "serverpath": "openocd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "configFiles": ["interface/stlink.cfg", "target/stm32g4x.cfg"],
      "serverArgs": ["-c", "transport select hla_swd", "-c", "adapter speed 1800"]
    }
  ]
}
