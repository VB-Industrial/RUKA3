{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "g431Joint",
      "type": "pickString",
      "description": "Joint to build or flash",
      "options": ["5", "6"],
      "default": "5"
    },
    {
      "id": "canChannel",
      "type": "promptString",
      "description": "SocketCAN interface",
      "default": "can0"
    }
  ],
  "tasks": [
    {
      "label": "RUKA3: Configure joint",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build/g431-joint${input:g431Joint}",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DRUKA3_BOARD=g431",
        "-DRUKA3_JOINT_INDEX=${input:g431Joint}",
        "-DRUKA3_BOOTSTRAP=OFF",
        "-DCYPHAL_NNVG_EXECUTABLE=${workspaceFolder}/build/.venv-nunavut/bin/nnvg"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "RUKA3: Build joint",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build/g431-joint${input:g431Joint}", "--target", "VBDrive_full_hex", "-j", "8"],
      "dependsOn": "RUKA3: Configure joint",
      "dependsOrder": "sequence",
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "RUKA3: Flash joint (SWD)",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32g4x.cfg",
        "-c", "program build/g431-joint${input:g431Joint}/Boards/g431/VBDrive_full.hex verify reset exit"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RUKA3: Flash joint (CAN, VBBoot)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "joint='${input:g431Joint}'; node_id=$((100 + joint)); python3 ThirdParty/VBBoot/tools/flash_bootloader_socketcan.py --hex \"build/g431-joint${input:g431Joint}/Boards/g431/VBDrive.hex\" --channel '${input:canChannel}' --node-id \"$node_id\" --id-format extended --brs --data-chunk-size 47 --inter-frame-delay-ms 3"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RUKA3: OpenOCD server",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32g4x.cfg",
        "-c", "transport select hla_swd",
        "-c", "adapter speed 1800"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
